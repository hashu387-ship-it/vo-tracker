# The app runs with no configuration at all: it falls back to a local libSQL
# file at .data/register.db and seeds itself from data/seed on first request.
#
# Set these only when you want the register to live somewhere shared.

# Hosted libSQL (Turso). Without this on a serverless host the app still runs,
# but falls back to the instance's temp directory: the register is per-instance
# and lost on a cold start. Set this for storage people can rely on.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Or point at any libSQL-compatible URL (libsql://, http://, file:).
# DATABASE_URL=file:./.data/register.db
# DATABASE_AUTH_TOKEN=

# A URL from a different application (Postgres, MySQL, a Prisma connection
# string) is ignored with a warning rather than passed to libSQL, which would
# otherwise fail the build.
