# The app runs with no configuration at all: it falls back to a local libSQL
# file at .data/register.db and seeds itself from data/seed on first request.
#
# Set these only when you want the register to live somewhere shared.

# Hosted libSQL (Turso) — required for a serverless deployment, where the
# filesystem is read-only and per-instance.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Or point at any libSQL-compatible URL (libsql://, http://, file:).
# DATABASE_URL=file:./.data/register.db
# DATABASE_AUTH_TOKEN=
